# secrets/.env 로 복사해 채운다. 비어 있지 않은 환경변수가 이 파일을 덮어쓴다.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
# 계좌번호 8자리 (config/accounts.yaml 의 cano 가 "00000000" 이면 여기서 읽는다)
KIS_PAPER_CANO=
KIS_REAL_CANO=
DART_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
FRED_API_KEY=
ECOS_API_KEY=
WEB_TOKEN=
