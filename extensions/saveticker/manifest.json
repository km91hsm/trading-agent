{
  "manifest_version": 3,
  "name": "SaveTicker 수집",
  "version": "1.0.4",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "https://www.saveticker.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.saveticker.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
